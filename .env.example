# Application Environment Configuration Template
# Copy to .env for local overrides (never commit .env!)

SALARY_APP_ENV=development
SALARY_LOG_LEVEL=INFO
SALARY_DATA_PATH=ds_salaries.csv
SALARY_DB_PATH=:memory:
SALARY_MIN_ROLE_SAMPLES=3
SALARY_TOP_ROLES_LIMIT=5
SALARY_API_HOST=0.0.0.0
SALARY_API_PORT=8000
SALARY_CORS_ORIGINS=http://localhost:3000,http://localhost:8000
SALARY_REQUEST_TIMEOUT_SECONDS=10.0
